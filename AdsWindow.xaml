<Window x:Class="GamepadSpeedController.AdsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="负压传感（ADS1256 采集卡）" Height="860" Width="1020"
        WindowStartupLocation="CenterOwner" Background="White" ResizeMode="CanResize"
        MinHeight="780" MinWidth="940">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="168"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 采集卡状态（ADS_STATUS / SEQ / 刷新率） -->
        <GroupBox Grid.Row="0" Header="采集卡状态（只读区 0x01A8 起 28 只 · 接口文档 §6.11）" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8">
                <Border x:Name="LedStatus" Width="14" Height="14" CornerRadius="7"
                        Background="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtStatus" Text="ADS_STATUS = --（等待数据）" FontWeight="Bold"
                           VerticalAlignment="Center" MinWidth="230"/>
                <TextBlock Text="SEQ:" Foreground="Gray" VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBlock x:Name="TxtSeq" Text="--" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="56"/>
                <TextBlock Text="扫描率:" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBlock x:Name="TxtRate" Text="-- Hz" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="60"/>
                <TextBlock Text="更新于:" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBlock x:Name="TxtAge" Text="--" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="96"/>
                <TextBlock x:Name="TxtSource" Text="数据源：主串口 _mb → Modbus FC03（只读）"
                           Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Row 1: 四路通道卡片 -->
        <GroupBox Grid.Row="1" Header="四路模拟输入（AIN0~AIN3，单 ADC 轮流采样 · 每通道约 60~80 Hz）" Margin="0,0,0,6">
            <UniformGrid Columns="4" Rows="1" Margin="4">
                <!-- 通道 1 -->
                <Border BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="6" Margin="0,2,4,2" Padding="10,8" Background="#FAFAFA">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="LedCh1" Width="12" Height="12" CornerRadius="6"
                                    Background="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="通道 1" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="AIN0" Foreground="Gray" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtV1" Text="-- V" FontFamily="Consolas" FontSize="24"
                                   FontWeight="Bold" Foreground="#0D47A1"/>
                        <ProgressBar x:Name="PbV1" Minimum="0" Maximum="5" Height="12" Value="0" Margin="0,6,0,8"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原始码" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtRaw1" Text="--" FontFamily="Consolas"
                                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="压力" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtP1" Text="-- kPa" FontFamily="Consolas"
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="#2E7D32"/>
                        </Grid>
                        <TextBlock x:Name="TxtJudge1" Text="等待数据" Foreground="Gray" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 通道 2 -->
                <Border BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="6" Margin="0,2,4,2" Padding="10,8" Background="#FAFAFA">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="LedCh2" Width="12" Height="12" CornerRadius="6"
                                    Background="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="通道 2" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="AIN1" Foreground="Gray" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtV2" Text="-- V" FontFamily="Consolas" FontSize="24"
                                   FontWeight="Bold" Foreground="#0D47A1"/>
                        <ProgressBar x:Name="PbV2" Minimum="0" Maximum="5" Height="12" Value="0" Margin="0,6,0,8"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原始码" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtRaw2" Text="--" FontFamily="Consolas"
                                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="压力" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtP2" Text="-- kPa" FontFamily="Consolas"
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="#2E7D32"/>
                        </Grid>
                        <TextBlock x:Name="TxtJudge2" Text="等待数据" Foreground="Gray" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 通道 3 -->
                <Border BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="6" Margin="0,2,4,2" Padding="10,8" Background="#FAFAFA">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="LedCh3" Width="12" Height="12" CornerRadius="6"
                                    Background="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="通道 3" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="AIN2" Foreground="Gray" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtV3" Text="-- V" FontFamily="Consolas" FontSize="24"
                                   FontWeight="Bold" Foreground="#0D47A1"/>
                        <ProgressBar x:Name="PbV3" Minimum="0" Maximum="5" Height="12" Value="0" Margin="0,6,0,8"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原始码" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtRaw3" Text="--" FontFamily="Consolas"
                                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="压力" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtP3" Text="-- kPa" FontFamily="Consolas"
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="#2E7D32"/>
                        </Grid>
                        <TextBlock x:Name="TxtJudge3" Text="等待数据" Foreground="Gray" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 通道 4 -->
                <Border BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="6" Margin="0,2,0,2" Padding="10,8" Background="#FAFAFA">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="LedCh4" Width="12" Height="12" CornerRadius="6"
                                    Background="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="通道 4" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="AIN3" Foreground="Gray" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtV4" Text="-- V" FontFamily="Consolas" FontSize="24"
                                   FontWeight="Bold" Foreground="#0D47A1"/>
                        <ProgressBar x:Name="PbV4" Minimum="0" Maximum="5" Height="12" Value="0" Margin="0,6,0,8"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原始码" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtRaw4" Text="--" FontFamily="Consolas"
                                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="压力" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtP4" Text="-- kPa" FontFamily="Consolas"
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="#2E7D32"/>
                        </Grid>
                        <TextBlock x:Name="TxtJudge4" Text="等待数据" Foreground="Gray" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </GroupBox>

        <!-- Row 2: 压力换算（两点标定） -->
        <GroupBox Grid.Row="2" Header="压力换算（两点标定 · 上位机做，固件 P0~P3 目前恒 0）" Margin="0,0,0,6">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="低点:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCalV1" Width="58" Text="0.500" Margin="4,0,0,0"
                             VerticalContentAlignment="Center" TextChanged="Calib_TextChanged"
                             ToolTip="量程低端对应的输出电压"/>
                    <TextBlock Text="V ↔" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBox x:Name="TxtCalP1" Width="58" Text="-100" Margin="0,0,0,0"
                             VerticalContentAlignment="Center" TextChanged="Calib_TextChanged"
                             ToolTip="量程低端的压力值，负压填负数"/>
                    <TextBlock Text="kPa" VerticalAlignment="Center" Margin="4,0,14,0"/>

                    <TextBlock Text="高点:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCalV2" Width="58" Text="4.500" Margin="4,0,0,0"
                             VerticalContentAlignment="Center" TextChanged="Calib_TextChanged"
                             ToolTip="量程高端对应的输出电压"/>
                    <TextBlock Text="V ↔" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBox x:Name="TxtCalP2" Width="58" Text="50"
                             VerticalContentAlignment="Center" TextChanged="Calib_TextChanged"
                             ToolTip="量程高端的压力值"/>
                    <TextBlock Text="kPa" VerticalAlignment="Center" Margin="4,0,14,0"/>

                    <TextBlock Text="零点修正:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPoff" Width="58" Text="0.0" Margin="4,0,0,0"
                             VerticalContentAlignment="Center" TextChanged="Poff_TextChanged"
                             ToolTip="选中通道的零点偏移(kPa)，用于吸收传感器零漂；四路各存一份"/>
                    <TextBlock Text="kPa" VerticalAlignment="Center" Margin="4,0,10,0"/>

                    <ComboBox x:Name="CbTareCh" Width="80" Margin="0,0,0,0" SelectedIndex="0"
                              SelectionChanged="CbTareCh_SelectionChanged"/>
                    <Button x:Name="BtnTare" Content="把当前记为零点" Width="126" Margin="8,0,0,0"
                            Click="BtnTare_Click"
                            ToolTip="令选中通道的当前读数 = 0 kPa（改的是零点修正，不改两点标定）"/>
                </StackPanel>
                <TextBlock x:Name="TxtCalcInfo" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                           Text="P = P₁ + (V − V₁) × (P₂ − P₁) / (V₂ − V₁) + 零点修正"/>
            </StackPanel>
        </GroupBox>

        <!-- Row 3: 趋势图 -->
        <GroupBox Grid.Row="3" Header="实时趋势（最近 30 秒 · 纵轴 0~5V）" Margin="0,0,0,6">
            <DockPanel>
                <!-- 图例：与曲线同色，四路恒定对应 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,4">
                    <Rectangle Width="16" Height="3" Fill="#D32F2F" VerticalAlignment="Center"/>
                    <TextBlock Text="AIN0" FontSize="11" Margin="5,0,14,0" Foreground="#444444"/>
                    <Rectangle Width="16" Height="3" Fill="#1976D2" VerticalAlignment="Center"/>
                    <TextBlock Text="AIN1" FontSize="11" Margin="5,0,14,0" Foreground="#444444"/>
                    <Rectangle Width="16" Height="3" Fill="#2E7D32" VerticalAlignment="Center"/>
                    <TextBlock Text="AIN2" FontSize="11" Margin="5,0,14,0" Foreground="#444444"/>
                    <Rectangle Width="16" Height="3" Fill="#F57C00" VerticalAlignment="Center"/>
                    <TextBlock Text="AIN3" FontSize="11" Margin="5,0,0,0" Foreground="#444444"/>
                </StackPanel>
                <Border x:Name="ChartHost" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                        CornerRadius="4" SizeChanged="ChartHost_SizeChanged">
                    <Grid>
                        <Canvas x:Name="GridCanvas" ClipToBounds="True"/>
                        <Canvas x:Name="CurveCanvas" ClipToBounds="True" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </DockPanel>
        </GroupBox>

        <!-- Row 4: 记录 -->
        <GroupBox Grid.Row="4" Header="记录（每通道 1 行/秒，写在程序所在目录 ads.csv）" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8">
                <CheckBox x:Name="CkRec" Content="CSV 记录（1 Hz）" VerticalAlignment="Center"
                          Checked="CkRec_Checked" Unchecked="CkRec_Unchecked"/>
                <Button x:Name="BtnOpenDir" Content="打开文件夹" Width="96" Margin="12,0,0,0"
                        Click="BtnOpenDir_Click"/>
                <TextBlock x:Name="TxtRecStatus" Text="未记录" Foreground="Gray"
                           VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>

        <!-- Row 5: 日志 + 判读提示 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="日志" Margin="0,0,6,0">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                         FontSize="11" Margin="8" Background="#FAFAFA"/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="判读提示（接线验证）">
                <TextBlock Margin="8" FontSize="11" TextWrapping="Wrap" Foreground="#444444"
                           LineHeight="17">
                    <Run Text="· 未接通道读 ≈1.2V：2.5V 偏置被 ADC 开关电容输入拉低（本量程下会算成约 −74 kPa，别当真）"/>
                    <LineBreak/>
                    <Run Text="· ≈0V 且 RAW≈0 → AIN 短地；≈5V 或 RAW=0x7FFFFF → 超量程"/>
                    <LineBreak/>
                    <Run Text="· STATUS≠0 或 SEQ 不涨 → 采集卡/SPI 故障，电压是最后一次成功值"/>
                    <LineBreak/>
                    <Run Text="· ACOM 实测 0V：V = code × 5 / 8388608，不加 2.5V"/>
                    <LineBreak/>
                    <Run Text="· 四路非同步采样；四根 VOUT 必须各接一个 AIN，不能并联"/>
                </TextBlock>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
