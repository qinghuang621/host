<Window x:Class="GamepadSpeedController.AttitudeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="姿态3D可视化" Height="640" Width="760"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Viewport3D x:Name="Viewport" Margin="4" ClipToBounds="True">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,-5.0,2.2"
                                       LookDirection="0,5.0,-2.2"
                                       UpDirection="0,0,1"
                                       FieldOfView="50"/>
                </Viewport3D.Camera>

                <!-- 灯光：白底下用较强的环境光 + 方向光做立体感 -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#BBBBBB"/>
                            <DirectionalLight Color="#666666" Direction="-1,-1,-1"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 左：四元数驱动的立方体，向右平移 -1.4 -->
                <ModelVisual3D x:Name="CubeQuat"/>

                <!-- 右：欧拉角驱动的立方体，向右平移 +1.4 -->
                <ModelVisual3D x:Name="CubeEuler"/>
            </Viewport3D>

            <!-- 2D 标签浮在 Viewport3D 上方，标明左右两个立方体的驱动方式 -->
            <TextBlock Text="四元数" HorizontalAlignment="Left" Margin="90,12,0,0"
                       Foreground="#333333" FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
            <TextBlock Text="欧拉角" HorizontalAlignment="Right" Margin="0,12,90,0"
                       Foreground="#333333" FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
        </Grid>

        <!-- 数值面板：上行欧拉角+状态+温度，中行倾斜角，下行四元数 -->
        <Border Grid.Row="1" Background="#F2F2F2" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Roll"  Foreground="#D32F2F" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRoll"  Text="0.0°" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="16" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="Pitch" Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPitch" Text="0.0°" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="16" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="Yaw"   Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtYaw"   Text="0.0°" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="16" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="IMU"   Foreground="#555555" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="--" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="14" MinWidth="70"/>
                    <TextBlock Text="Temp"  Foreground="#555555" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTemp"   Text="--" Foreground="#222222" Margin="6,0,0,0"
                               FontSize="14" MinWidth="60"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="倾斜角 θ" Foreground="#E65100" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTilt" Text="0.0°" Foreground="#222222" Margin="6,0,0,0"
                               FontSize="15" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="（车体Z轴与竖直向上的夹角）" Foreground="#888888"
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="Quat" Foreground="#777777" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtQuat" Text="( -- )" Foreground="#333333" Margin="6,0,0,0"
                               FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <!-- IST8310 磁力计：融合状态 + 初始化错误码 + 原始三轴 μT + 模值 -->
                <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,5,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="MAG" Foreground="#6A1B9A" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="MagStateBadge" Background="#BDBDBD" CornerRadius="3"
                            Margin="8,0,8,0" Padding="8,1">
                        <TextBlock x:Name="TxtMagState" Text="--" Foreground="White"
                                   FontSize="13" FontWeight="Bold"/>
                    </Border>
                    <!-- 九轴切换按钮：写 0x014A=1 开启 / =0 强制六轴 -->
                    <Button x:Name="BtnMagOn"  Content="九轴" Width="46" Height="22"
                            Click="BtnMagOn_Click"  Margin="0,0,4,0" FontSize="11" Padding="0,1"
                            ToolTip="写 0x014A=1，允许九轴融合（IST8310 在线时激活）"/>
                    <Button x:Name="BtnMagOff" Content="六轴" Width="46" Height="22"
                            Click="BtnMagOff_Click" Margin="0,0,12,0" FontSize="11" Padding="0,1"
                            ToolTip="写 0x014A=0，强制六轴（yaw 会漂）"/>
                    <TextBlock Text="INIT" Foreground="#777777" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMagInit" Text="--" Foreground="#333333" Margin="6,0,14,0"
                               FontSize="13" MinWidth="64"/>
                    <TextBlock Text="X" Foreground="#D32F2F" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMagX" Text="--" Foreground="#222222" Margin="4,0,12,0"
                               FontSize="13" MinWidth="64"/>
                    <TextBlock Text="Y" Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMagY" Text="--" Foreground="#222222" Margin="4,0,12,0"
                               FontSize="13" MinWidth="64"/>
                    <TextBlock Text="Z" Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMagZ" Text="--" Foreground="#222222" Margin="4,0,12,0"
                               FontSize="13" MinWidth="64"/>
                    <TextBlock Text="|B|" Foreground="#777777" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMagNorm" Text="--" Foreground="#333333" Margin="6,0,0,0"
                               FontSize="13" FontWeight="SemiBold" MinWidth="64"/>
                    <TextBlock Text="μT（未校准，转动车体模值应恒定）" Foreground="#888888"
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                </Border>

                <!-- ===== 运动控制输出区（2026-09-30 新增 · 接口文档.md §6.10）=====
                     上位机 ROS2 要的四组量里的另两组：线加速度（比力）+ 姿态协方差。
                     协方差对角 = (σ×π/180)²，σ 由固件可写寄存器 0x00C0~0x00C5 决定
                     （默认 1.0/1.0/10.0 度）⇒ 这里**开方回角度**显示更直观。 -->
                <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,5,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="ACCEL" Foreground="#EF6C00" FontWeight="Bold" VerticalAlignment="Center"
                                       ToolTip="0x0190~0x0195 机体系线加速度 = 比力（含重力、固件不减）。静止水平时 ACCEL_Z ≈ +9.8 m/s²"/>
                            <TextBlock Text="X" Foreground="#D32F2F" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock x:Name="TxtAccelX" Text="--" Foreground="#222222" Margin="4,0,12,0"
                                       FontSize="13" MinWidth="66"/>
                            <TextBlock Text="Y" Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAccelY" Text="--" Foreground="#222222" Margin="4,0,12,0"
                                       FontSize="13" MinWidth="66"/>
                            <TextBlock Text="Z" Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAccelZ" Text="--" Foreground="#222222" Margin="4,0,12,0"
                                       FontSize="13" MinWidth="66"/>
                            <TextBlock Text="m/s²（比力，含重力）" Foreground="#888888"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="COV σ" Foreground="#00838F" FontWeight="Bold" VerticalAlignment="Center"
                                       ToolTip="0x0196~0x01A7 姿态协方差 3×3（rad²）的对角项开方（deg）。固件非对角恒 0；σ 可现场写 0x00C0~0x00C5"/>
                            <TextBlock Text="roll" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock x:Name="TxtCovRoll" Text="--" Foreground="#222222" Margin="4,0,12,0"
                                       FontSize="13" MinWidth="56"/>
                            <TextBlock Text="pitch" Foreground="#777777" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCovPitch" Text="--" Foreground="#222222" Margin="4,0,12,0"
                                       FontSize="13" MinWidth="56"/>
                            <TextBlock Text="yaw" Foreground="#777777" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCovYaw" Text="--" Foreground="#222222" Margin="4,0,12,0"
                                       FontSize="13" MinWidth="56"/>
                            <TextBlock Text="°（对角开方）" Foreground="#888888"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 【临时诊断 2026-09-23】磁力计 I2C 链路健康度（固件 0x0184~0x018C）=====
                     ⚠️🔴 与固件同名的"临时诊断区"配套。2026-09-30 长老决定：测试期间保留，
                     host 先对齐；**将来固件删除 0x0184~0x018C 时，本块要一起删**
                     （连同 AttitudeWindow.xaml.cs 的 UpdateMagDiag() 与 ModbusClient 的对应常量/字段）。 -->
                <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="0,4,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="I2C" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Border x:Name="GlitchLamp" Width="12" Height="12" CornerRadius="6"
                                    Background="#BDBDBD" Margin="6,0,6,0" VerticalAlignment="Center"
                                    ToolTip="灰=未建立链路（INIT 失败）　绿=健康　黄闪=毛刺发生但已被自愈救回　红=卡死（MAG_OK 冻结）"/>
                            <TextBlock x:Name="TxtGlitch" Text="--" Foreground="#555555"
                                       FontSize="12" FontWeight="Bold" MinWidth="80"
                                       Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVE" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x014B MAG_STATUS。**这是分辨固件版本的关键**：=1 说明固件用的是旧判据(present&amp;&amp;enable)；=0 说明含 09-29 的读数健康判据(fail_streak&lt;3)"/>
                            <TextBlock x:Name="TxtMagActive2" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="34" Margin="6,0,14,0"/>
                            <TextBlock Text="RECOVER" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x018C：I2C3 自愈复位次数 = 毛刺发生次数。括号内为本次刷新窗口内的增量"/>
                            <TextBlock x:Name="TxtMagRecover" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="78" Margin="6,0,14,0"/>
                            <TextBlock Text="OK" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x0188：I2C 读成功累计（100Hz 读取，正常时约每秒 +100）。不涨即卡死"/>
                            <TextBlock x:Name="TxtMagOk" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="72" Margin="6,0,14,0"/>
                            <TextBlock Text="ERR" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x0187：I2C 读失败累计。括号内为增量 —— ERR 还在涨=固件仍在校验总线；ERR 也冻结=读取循环整体停摆"/>
                            <TextBlock x:Name="TxtMagErr" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="86" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="HAL" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x0189：最后一次 HAL 返回码。0=OK 1=ERROR 2=BUSY 3=TIMEOUT"/>
                            <TextBlock x:Name="TxtMagHal" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="68" Margin="6,0,18,0"/>
                            <TextBlock Text="STATE" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x018A：hi2c3.State。0x20=READY 0x24=BUSY 0xA0=TIMEOUT 0xE0=ERROR"/>
                            <TextBlock x:Name="TxtMagI2cState" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="58" Margin="6,0,18,0"/>
                            <TextBlock Text="ECODE" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x018B：hi2c3.ErrorCode。0x04=AF(NACK) 0x01=BERR 0x02=ARLO 0x20=TIMEOUT"/>
                            <TextBlock x:Name="TxtMagEcode" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="54" Margin="6,0,18,0"/>
                            <TextBlock Text="RAW" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="0x0184~0x0186：int16 原始计数（不乘 0.3）"/>
                            <TextBlock x:Name="TxtMagRaw" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="150" Margin="6,0,0,0"/>
                            <TextBlock Text="融合" Foreground="#777777" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                                       ToolTip="由磁读计数推算的实际融合频率：固件 s_mag_read_div 数的是【循环次数】，满 10 次才读一次磁 ⇒ 融合频率 = (OK+ERR) 速率 × 10。额定 1000 Hz（INS_SAMPLE_PERIOD_MS=1）"/>
                            <TextBlock x:Name="TxtMagFusion" Text="--" Foreground="#333333"
                                       FontSize="12" MinWidth="80" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
