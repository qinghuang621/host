<Window x:Class="GamepadSpeedController.AttitudeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="姿态3D可视化" Height="640" Width="760"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Viewport3D x:Name="Viewport" Margin="4" ClipToBounds="True">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,-5.0,2.2"
                                       LookDirection="0,5.0,-2.2"
                                       UpDirection="0,0,1"
                                       FieldOfView="50"/>
                </Viewport3D.Camera>

                <!-- 灯光：白底下用较强的环境光 + 方向光做立体感 -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#BBBBBB"/>
                            <DirectionalLight Color="#666666" Direction="-1,-1,-1"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 左：四元数驱动的立方体，向右平移 -1.4 -->
                <ModelVisual3D x:Name="CubeQuat"/>

                <!-- 右：欧拉角驱动的立方体，向右平移 +1.4 -->
                <ModelVisual3D x:Name="CubeEuler"/>
            </Viewport3D>

            <!-- 2D 标签浮在 Viewport3D 上方，标明左右两个立方体的驱动方式 -->
            <TextBlock Text="四元数" HorizontalAlignment="Left" Margin="90,12,0,0"
                       Foreground="#333333" FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
            <TextBlock Text="欧拉角" HorizontalAlignment="Right" Margin="0,12,90,0"
                       Foreground="#333333" FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
        </Grid>

        <!-- 数值面板：上行欧拉角+状态+温度，中行倾斜角，下行四元数 -->
        <Border Grid.Row="1" Background="#F2F2F2" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Roll"  Foreground="#D32F2F" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRoll"  Text="0.0°" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="16" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="Pitch" Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPitch" Text="0.0°" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="16" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="Yaw"   Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtYaw"   Text="0.0°" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="16" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="IMU"   Foreground="#555555" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="--" Foreground="#222222" Margin="6,0,18,0"
                               FontSize="14" MinWidth="70"/>
                    <TextBlock Text="Temp"  Foreground="#555555" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTemp"   Text="--" Foreground="#222222" Margin="6,0,0,0"
                               FontSize="14" MinWidth="60"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="倾斜角 θ" Foreground="#E65100" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTilt" Text="0.0°" Foreground="#222222" Margin="6,0,0,0"
                               FontSize="15" FontWeight="Bold" MinWidth="80"/>
                    <TextBlock Text="（车体Z轴与竖直向上的夹角）" Foreground="#888888"
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="Quat" Foreground="#777777" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtQuat" Text="( -- )" Foreground="#333333" Margin="6,0,0,0"
                               FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
