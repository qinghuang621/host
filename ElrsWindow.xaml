<Window x:Class="GamepadSpeedController.ElrsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ELRS 手柄（Pocket 遥控器）" Height="720" Width="780"
        WindowStartupLocation="CenterOwner" Background="White" ResizeMode="CanResize"
        MinHeight="600" MinWidth="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 端口 + 启用 + 测试 + RSSI -->
        <GroupBox Grid.Row="0" Header="ELRS 接收机（CRSF 协议，420000 8N1）" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock Text="端口:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CbCrsfPort" Width="100" Margin="8,0,0,0"/>
                <CheckBox x:Name="ChkCrsfEnable" Content="启用 ELRS" VerticalAlignment="Center" Margin="12,0,0,0"
                          Checked="ChkCrsfEnable_Checked" Unchecked="ChkCrsfEnable_Unchecked"/>
                <Button x:Name="BtnCrsfTest" Content="测试链路" Width="80" Margin="12,0,0,0"
                        Click="BtnCrsfTest_Click"
                        ToolTip="自检 3 秒：字节数 / 0xC8 帧头数 / 有效帧数 / 通道值"/>
                <TextBlock Text="RSSI:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="TxtCrsfRssi" Text="-- dBm" VerticalAlignment="Center" Margin="4,0,0,0"
                           FontFamily="Consolas" FontWeight="Bold" MinWidth="64"/>
                <TextBlock x:Name="TxtLinkState" Text="未启用" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontWeight="Bold" Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- Row 1: 摇杆可视化 + vx/vy/wz -->
        <GroupBox Grid.Row="1" Header="摇杆输入（映射到车体速度）" Margin="0,0,0,6">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="左Y (vy):" VerticalAlignment="Center"/>
                <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="PbLY" Minimum="-1" Maximum="1" Height="20" Margin="8,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="左X (vx):" VerticalAlignment="Center"/>
                <ProgressBar Grid.Row="0" Grid.Column="3" x:Name="PbLX" Minimum="-1" Maximum="1" Height="20" Margin="8,0"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="右X (wz):" VerticalAlignment="Center"/>
                <ProgressBar Grid.Row="0" Grid.Column="5" x:Name="PbRX" Minimum="-1" Maximum="1" Height="20" Margin="8,0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="vy=" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtVy" Text="0.00" VerticalAlignment="Center" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="vx=" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtVx" Text="0.00" VerticalAlignment="Center" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="wz=" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="5" x:Name="TxtWz" Text="0.00" VerticalAlignment="Center" FontFamily="Consolas"/>
            </Grid>
        </GroupBox>

        <!-- Row 2: 11 通道实时值 + 档位/使能说明 -->
        <GroupBox Grid.Row="2" Header="CRSF 通道（11 通道，归一化 -1..+1）" Margin="0,0,0,6">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- CH1..CH6 关键通道高亮 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="CH1 右X→wz" Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCh1" Text="0.000" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="CH3 左Y→vy" Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtCh3" Text="0.000" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="CH4 左X→vx" Foreground="#D32F2F" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="5" x:Name="TxtCh4" Text="0.000" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="CH5 档位" Foreground="#E65100" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="7" x:Name="TxtCh5" Text="0.000" FontFamily="Consolas" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="CH6 使能" Foreground="#6A1B9A" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtCh6" Text="0.000" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="CH2" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtCh2" Text="0.000" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="CH7" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="5" x:Name="TxtCh7" Text="0.000" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="6" Text="CH8-11" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="7" x:Name="TxtChRest" Text="--" FontFamily="Consolas" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Row 3: 日志区（测试结果 / 连接日志 / 失联警告） -->
        <GroupBox Grid.Row="3" Header="日志（测试结果 · 连接 · 失联警告）">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                     FontSize="11" Margin="8" Background="#FAFAFA"/>
        </GroupBox>
    </Grid>
</Window>
