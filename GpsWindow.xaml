<Window x:Class="GamepadSpeedController.GpsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPS 定位（NMEA 0183）" Height="820" Width="840"
        WindowStartupLocation="CenterOwner" Background="White" ResizeMode="CanResize"
        MinHeight="660" MinWidth="740">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 串口配置 -->
        <GroupBox Grid.Row="0" Header="GPS 模块串口（NEO-6M / 7N / M8N，NMEA 0183 文本协议）" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock Text="端口:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CbGpsPort" Width="100" Margin="8,0,0,0"/>
                <TextBlock Text="波特率:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox x:Name="CbGpsBaud" Width="90" Margin="8,0,0,0"/>
                <CheckBox x:Name="ChkGpsEnable" Content="启用读取" VerticalAlignment="Center" Margin="12,0,0,0"
                          Checked="ChkGpsEnable_Checked" Unchecked="ChkGpsEnable_Unchecked"/>
                <Button x:Name="BtnGpsTest" Content="测试连接" Width="88" Margin="12,0,0,0"
                        Click="BtnGpsTest_Click"
                        ToolTip="自检 3 秒：字节数 / NMEA 句子数 / 校验通过数 / 句子类型统计 / 定位状态"/>
                <TextBlock x:Name="TxtGpsState" Text="未启用" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontWeight="Bold" Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- Row 1: 定位状态 -->
        <GroupBox Grid.Row="1" Header="定位状态" Margin="0,0,0,6">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="定位:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtFix" Text="无定位" FontWeight="Bold" FontSize="14"
                           Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="卫星(已用/可见):" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="TxtSats" Text="0 / 0" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="HDOP:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" x:Name="TxtHdop" Text="--" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="海拔:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="7" x:Name="TxtAlt" Text="-- m" FontFamily="Consolas" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Row 2: 位置 / 时间 / 速度 -->
        <GroupBox Grid.Row="2" Header="位置与时间" Margin="0,0,0,6">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="纬度:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtLat" Text="--" FontFamily="Consolas"
                           FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="经度:" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtLon" Text="--" FontFamily="Consolas"
                           FontSize="13" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="UTC 时间:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtUtcTime" Text="--:--:--" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="UTC 日期:" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtUtcDate" Text="--" FontFamily="Consolas"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="地速:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtSpeed" Text="--" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="航向:" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtCourse" Text="--" FontFamily="Consolas"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="定位类型:" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtFixType" Text="--" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="PDOP / VDOP:" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="3" x:Name="TxtDop" Text="-- / --" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Row 3: 卫星 SNR -->
        <GroupBox Grid.Row="3" Header="可见卫星 SNR（GSV）" Margin="0,0,0,6">
            <TextBlock x:Name="TxtSatSnr" Text="(无)" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap" Margin="8"/>
        </GroupBox>

        <!-- Row 4: 原始 NMEA -->
        <GroupBox Grid.Row="4" Header="原始 NMEA 句子（最近一条 GGA / RMC / GSA / GSV）" Margin="0,0,0,6">
            <StackPanel Margin="8">
                <TextBlock x:Name="TxtRawGga" Text="GGA: --" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtRawRmc" Text="RMC: --" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtRawGsa" Text="GSA: --" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtRawGsv" Text="GSV: --" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Row 5: 日志 -->
        <GroupBox Grid.Row="5" Header="日志（测试结果 · 连接 · 掉线警告）">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                     FontSize="11" Margin="8" Background="#FAFAFA"/>
        </GroupBox>
    </Grid>
</Window>