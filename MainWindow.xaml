<Window x:Class="GamepadSpeedController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STM32 小车控制台" Height="900" Width="960"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" MinHeight="760" MinWidth="820"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 串口 -->
        <GroupBox Grid.Row="0" Header="串口" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock Text="端口:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="CbPort" Width="100"/>
                <TextBlock Text="波特率:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <ComboBox x:Name="CbBaud" Width="80" IsEditable="True"/>
                <Button x:Name="BtnConnect" Content="连接" Width="80" Margin="12,0,0,0" Click="BtnConnect_Click"/>
                <TextBlock x:Name="TxtStatus" Text="未连接" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button x:Name="BtnAttitude3D" Content="姿态3D" Width="72" Margin="16,0,0,0"
                        Click="BtnAttitude3D_Click" Background="LightSteelBlue"/>
            </StackPanel>
        </GroupBox>

        <!-- 使能控制 -->
        <GroupBox Grid.Row="1" Header="电机控制" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8">
                <Button x:Name="BtnEnable" Content="使能电机" Width="100" Click="BtnEnable_Click" Background="LightGray"/>
                <Button x:Name="BtnEStop" Content="紧急停止" Width="90" Margin="12,0,0,0"
                        Background="#FFD65555" Foreground="White" FontWeight="Bold" Click="BtnEStop_Click"/>
                <TextBlock x:Name="TxtEnableState" Text="状态：失能" Foreground="Gray" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- TabControl -->
        <TabControl Grid.Row="2" Margin="0,0,0,6">

            <!-- ===== Tab 1: 手动控制 ===== -->
            <TabItem Header="手动控制">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 速度输入 -->
                    <GroupBox Grid.Row="0" Header="速度命令 (vx, vy, wz)" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="vx:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtVx" Width="70" Text="0.0" Margin="4,0,0,4"/>
                            <TextBlock Text="vy:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox x:Name="TxtVy" Width="70" Text="0.0" Margin="4,0,0,4"/>
                            <TextBlock Text="wz:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox x:Name="TxtWz" Width="70" Text="0.0" Margin="4,0,0,4"/>
                            <Button x:Name="BtnSend" Content="发送" Width="60" Margin="12,0,0,0" Click="BtnSend_Click"/>
                            <CheckBox x:Name="ChkHeartbeat" Content="持续发送(心跳100ms)" VerticalAlignment="Center" Margin="16,0,0,0"
                                      Checked="ChkHeartbeat_Checked" Unchecked="ChkHeartbeat_Unchecked"/>
                            <TextBlock Text="  m/s, rad/s" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 监控表格 -->
                    <GroupBox Grid.Row="1" Header="电机监控（每300ms刷新）" Margin="0,0,0,6">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="电机" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="1(LF)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="2(RF)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="3(RR)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="4(LR)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ERR"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtErr1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtErr2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtErr3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" x:Name="TxtErr4" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="命令速"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtCmdVel1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TxtCmdVel2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtCmdVel3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" x:Name="TxtCmdVel4" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="实际速"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtActVel1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="TxtActVel2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="TxtActVel3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="4" x:Name="TxtActVel4" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="温度℃"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtTemp1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="TxtTemp2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="TxtTemp3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="4" x:Name="TxtTemp4" HorizontalAlignment="Center"/>
                        </Grid>
                    </GroupBox>

                    <!-- 调试日志 -->
                    <GroupBox Grid.Row="2" Header="调试日志">
                        <TextBox x:Name="TxtDebugLog" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 FontSize="11" Margin="8"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ===== Tab 2: 手柄控制 ===== -->
            <TabItem Header="手柄控制">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 手柄状态 -->
                    <GroupBox Grid.Row="0" Header="手柄状态" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="设备:" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPadName" Text="未检测" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
                            <TextBlock Text="档位:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <ComboBox x:Name="CbGear" Width="80" Margin="8,0,0,0" SelectionChanged="CbGear_SelectionChanged"/>
                            <CheckBox x:Name="ChkPadEnable" Content="启用手柄" VerticalAlignment="Center" Margin="20,0,0,0"
                                      Checked="ChkPadEnable_Checked" Unchecked="ChkPadEnable_Unchecked"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 摇杆实时值 -->
                    <GroupBox Grid.Row="1" Header="摇杆输入" Margin="0,0,0,6">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="左摇杆Y (vx):" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="PbLY" Minimum="-1" Maximum="1" Height="20" Margin="8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="左摇杆X (vy):" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="3" x:Name="PbLX" Minimum="-1" Maximum="1" Height="20" Margin="8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="右摇杆X (wz):" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="5" x:Name="PbRX" Minimum="-1" Maximum="1" Height="20" Margin="8,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="vx=" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPadVx" Text="0.00" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="vy=" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtPadVy" Text="0.00" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="wz=" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="5" x:Name="TxtPadWz" Text="0.00" VerticalAlignment="Center"/>
                        </Grid>
                    </GroupBox>

                    <!-- 手柄监控表格 -->
                    <GroupBox Grid.Row="2" Header="电机监控" Margin="0,0,0,6">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="电机" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="1(LF)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="2(RF)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="3(RR)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="4(LR)" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ERR"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPadErr1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtPadErr2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtPadErr3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" x:Name="TxtPadErr4" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="命令速"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPadCmdVel1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TxtPadCmdVel2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtPadCmdVel3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" x:Name="TxtPadCmdVel4" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="实际速"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPadActVel1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="TxtPadActVel2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="TxtPadActVel3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="4" x:Name="TxtPadActVel4" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="温度℃"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtPadTemp1" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="TxtPadTemp2" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="TxtPadTemp3" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="4" x:Name="TxtPadTemp4" HorizontalAlignment="Center"/>
                        </Grid>
                    </GroupBox>

                    <!-- 手柄说明 -->
                    <GroupBox Grid.Row="3" Header="操作说明">
                        <StackPanel Margin="8">
                            <TextBlock Text="左摇杆 Y → 前后移动 (vx)" Margin="0,2"/>
                            <TextBlock Text="左摇杆 X → 左右平移 (vy)" Margin="0,2"/>
                            <TextBlock Text="右摇杆 X → 旋转 (wz)" Margin="0,2"/>
                            <TextBlock Text="A 键 → 使能电机  |  B 键 → 失能电机" Margin="0,2"/>
                            <TextBlock Text="Start → 紧急停止" Margin="0,2"/>
                            <TextBlock Text="左/右扳机 → 切换档位（慢/中/快）" Margin="0,2" Foreground="Gray"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ===== Tab 3: 风机控制（Modbus，复用主串口 _mb） ===== -->
            <TabItem Header="风机控制">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 前置条件检查（7 项红绿灯 + 状态行 + 一键检查按钮） -->
                    <GroupBox Grid.Row="0" Header="LUT 模式前置条件（接口文档 §6.4/§6.7）" Margin="0,0,0,4">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                <Button x:Name="BtnFanCheckPre" Content="一键检查" Width="90" Height="28"
                                        Margin="0,0,12,0" Click="BtnFanCheckPre_Click" Background="LightYellow"/>
                                <!-- 7 个红绿灯：圆点 Border + 标签 -->
                                <Border x:Name="LedPreImu" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="IMU=2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="LedPreMagic" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MAGIC=0xA5C3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="LedPreLut" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LUT 13 格" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="LedPreAutoEn" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="AUTO_EN=1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="LedPreMode" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MODE=2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="LedPreDutyMin" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DUTY_MIN>0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="LedPreOffset" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OFFSET 已校" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Grid.Row="1" x:Name="TxtPreStatus" Text="未检查"
                                       Foreground="Gray" Margin="0,4,0,0" FontFamily="Consolas"/>
                        </Grid>
                    </GroupBox>

                    <!-- Row 1: 模式切换（手动 / 线性 / 查表 / 紧急停止） -->
                    <GroupBox Grid.Row="1" Header="模式切换" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <Button x:Name="BtnFanManual" Content="手动 (0x0140=0)" Width="130" Height="32"
                                    Click="BtnFanManual_Click" Background="LightGray"/>
                            <Button x:Name="BtnFanLinear" Content="线性 (FAN_MODE=1)" Width="130" Height="32"
                                    Margin="8,0,0,0" Click="BtnFanLinear_Click" Background="LightSkyBlue"/>
                            <Button x:Name="BtnFanLut" Content="查表 LUT (FAN_MODE=2)" Width="140" Height="32"
                                    Margin="8,0,0,0" Click="BtnFanLut_Click" Background="LightGreen"/>
                            <Button x:Name="BtnFanEStop" Content="■ 紧急停止" Width="120" Height="32"
                                    Margin="24,0,0,0" Click="BtnFanEStop_Click"
                                    Background="#FFD65555" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Row 2: 共用区（倾斜角 θ + AUTO_DUTY + IMU 状态） -->
                    <GroupBox Grid.Row="2" Header="共用反馈（θ / AUTO_DUTY / IMU 状态）" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="倾斜角 θ:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTheta" Text="--°" FontSize="18" FontWeight="Bold"
                                       Foreground="#E65100" Margin="6,0,24,0" MinWidth="80"/>
                            <TextBlock Text="AUTO_DUTY:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAutoDuty" Text="--%" FontSize="18" FontWeight="Bold"
                                       Foreground="#1565C0" Margin="6,0,24,0" MinWidth="80"/>
                            <TextBlock Text="IMU:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtImuStatus" Text="--" FontSize="14" FontWeight="Bold"
                                       Margin="6,0,24,0" MinWidth="60"/>
                            <TextBlock Text="FAN_MODE:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFanMode" Text="--" FontSize="14" FontWeight="Bold"
                                       Foreground="#2E7D32" Margin="6,0,0,0" MinWidth="80"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Row 3: 四风机面板（UniformGrid 4 列，每列卡片式布局） -->
                    <GroupBox Grid.Row="3" Header="四路风机（目标 / 实际占空比 / 脉冲 / 转速反馈）">
                        <UniformGrid Columns="4" Rows="1" Margin="4">
                            <!-- 风机 1 -->
                            <Border BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="6" Margin="0,2,4,2" Padding="8,6" Background="#FAFAFA">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 标题行：RUN 灯 + 风机名 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border x:Name="LedFan1Run" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="风机 1" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- 目标占空比：标签 + 滑块 + 数值（一行紧凑） -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="目标" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Slider Grid.Column="1" x:Name="SlFan1Duty" Minimum="0" Maximum="100" Value="0"
                                                AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"
                                                ValueChanged="SlFanDuty_ValueChanged" Tag="1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtFan1Duty" Text="0%" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40" TextAlignment="Right"/>
                                    </Grid>
                                    <!-- 实际占空比：标签 + ProgressBar + 数值 -->
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="实际" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ProgressBar Grid.Column="1" x:Name="PbFan1DutyFb" Minimum="0" Maximum="100" Height="16" Value="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtFan1DutyFb" Text="--%" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40" TextAlignment="Right"/>
                                    </Grid>
                                    <!-- 分隔线 -->
                                    <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,4,0,4"/>
                                    <!-- 反馈区：脉冲 + 转速（突出显示，浅蓝背景） -->
                                    <Border Grid.Row="4" Background="#E3F2FD" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="脉冲反馈" FontWeight="Bold" Foreground="#0D47A1" FontSize="11"/>
                                            <TextBlock x:Name="TxtFan1Pulse" Text="--" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,2,0,6"/>
                                            <TextBlock Text="转速" FontWeight="Bold" Foreground="#0D47A1" FontSize="11"/>
                                            <TextBlock x:Name="TxtFan1Rpm" Text="-- RPM" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 风机 2 -->
                            <Border BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="6" Margin="0,2,4,2" Padding="8,6" Background="#FAFAFA">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border x:Name="LedFan2Run" Width="14" Height="14" CornerRadius="7" Background="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="风机 2" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
